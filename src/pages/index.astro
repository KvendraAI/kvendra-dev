---
import BaseLayout from '../layouts/BaseLayout.astro';
import OutcomeCards from '../components/landing/OutcomeCards.astro';
import WhyTiles from '../components/landing/WhyTiles.astro';

const githubUrl = 'https://github.com/KvendraAI';
---

<BaseLayout
  title="Kvendra — stop your AI agent from re-deciding your project"
  description="Your AI coding agent loses the thread of your project and re-decides things. Kvendra gives it a structured, queryable knowledge base — plus traceable pipelines — so it stops re-deciding and you stay in control. Self-hostable, MCP-native, open core."
>
  <section class="kvd-hero">
    <span class="kvd-kicker">kvendra.dev · open core</span>
    <h1>Stop your AI agent from re-deciding your project.</h1>
    <p class="kvd-hero__lead">
      Your AI coding agent loses the thread of your project and re-decides
      things you already settled. Kvendra gives it a structured, queryable
      knowledge base of your project — plus traceable pipelines — so it stops
      re-deciding and you stay in control.
    </p>
    <p class="kvd-hero__example">
      Ask <em>“how do we avoid leaking tokens”</em> and it surfaces the relevant
      decision even if those exact words never appear — because Kvendra finds the
      right thing by meaning, not by keyword.
    </p>
    <div class="kvd-hero__ctas">
      <a class="kvd-btn kvd-btn--primary" href="/docs/getting-started/"
        >Get Started</a
      >
      <a class="kvd-btn" href="/install-with-ai/">Install with your AI</a>
      <a class="kvd-btn" href={githubUrl}>View on GitHub</a>
    </div>
    <p class="kvd-hero__first-ten">
      Your first 10 minutes — all inside Claude Code, no terminal:
    </p>
    <pre class="kvd-hero__install"><code>{`# in Claude Code
/plugin marketplace add KvendraAI/kvendra-skills
/plugin install kvendra-skills@kvendra-marketplace
/setup self-hosted`}</code></pre>
    <p class="kvd-hero__install-note">
      You need Docker running. The wizard does the rest: it finds an existing
      reference-stack clone or clones one for you, brings it up with local
      embeddings, and wires Claude Code.
    </p>
    <p class="kvd-hero__see-why">
      <a href="/use-cases/">See what you actually get out of it →</a>
    </p>
  </section>

  <section class="kvd-section">
    <h2 class="kvd-section__title">How it's put together</h2>
    <p class="kvd-section__intro">
      Three open-core pieces: <strong>Platform</strong> is the required core —
      the knowledge base. <strong>Skills</strong> are your day-to-day — pipelines
      run as one-command workflows on top of it. The <strong>CLI</strong> is a
      foundational security layer that is optional to get started; add it when
      you want your agent to run real ops (a git push, a deploy) without seeing
      your tokens.
    </p>
    <OutcomeCards />
  </section>

  <section class="kvd-section">
    <h2 class="kvd-section__title">Why Kvendra</h2>
    <WhyTiles />
  </section>
</BaseLayout>

<style>
  .kvd-hero__lead {
    font-size: var(--fs-body);
    color: var(--fg);
    max-width: 60ch;
  }
  .kvd-hero__example {
    color: var(--fog);
    max-width: 60ch;
    margin-top: var(--sp-3);
  }
  .kvd-hero__example em {
    color: var(--fg);
  }
  .kvd-hero__first-ten {
    font-family: var(--mono);
    font-size: var(--fs-xs);
    letter-spacing: var(--ls-tick);
    text-transform: uppercase;
    color: var(--phos-readable);
    margin-top: var(--sp-6);
    margin-bottom: var(--sp-2);
  }
  .kvd-hero__install-note {
    color: var(--fog);
    max-width: 60ch;
    margin-top: var(--sp-3);
    font-size: var(--fs-sm);
  }
  .kvd-hero__see-why {
    margin-top: var(--sp-4);
    font-size: var(--fs-sm);
  }
  .kvd-section__intro {
    color: var(--fog);
    max-width: 68ch;
    margin-bottom: var(--sp-5);
  }

  .kvd-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-top: var(--sp-6);
  }

  .kvd-btn {
    display: inline-flex;
    align-items: center;
    padding: var(--sp-3) var(--sp-5);
    font-family: var(--display);
    font-size: var(--fs-sm);
    font-weight: 600;
    letter-spacing: var(--ls-tight);
    border: 1px solid var(--line-soft);
    color: var(--fg);
    transition: border-color var(--dur-mecanico) var(--ease-mecanico),
      background-color var(--dur-mecanico) var(--ease-mecanico),
      color var(--dur-mecanico) var(--ease-mecanico);
  }
  .kvd-btn:hover {
    border-color: var(--phos);
  }
  .kvd-btn--primary {
    border-color: var(--phos);
    background: var(--phos);
    color: var(--ink);
  }
  .kvd-btn--primary:hover {
    background: var(--phos-dim);
    border-color: var(--phos-dim);
  }

  .kvd-hero__install {
    font-family: var(--mono);
    font-size: var(--fs-sm);
    line-height: 1.6;
    background: var(--bg-sunk);
    border: 1px solid var(--line-soft);
    border-left: 3px solid var(--phos);
    padding: var(--sp-4);
    overflow-x: auto;
    margin-top: var(--sp-2);
    max-width: 100%;
  }
  .kvd-hero__install code {
    font-family: var(--mono);
    letter-spacing: var(--ls-mono);
  }

  .kvd-section {
    margin-top: var(--sp-8);
  }
  .kvd-section__title {
    font-family: var(--display);
    font-size: var(--fs-h2);
    font-weight: 600;
    letter-spacing: var(--ls-tight);
    margin-bottom: var(--sp-2);
    padding-bottom: var(--sp-2);
    border-bottom: 1px solid var(--line-soft);
  }
</style>
