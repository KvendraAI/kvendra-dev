---
import DocsLayout from '../../layouts/DocsLayout.astro';

// The docs index. Mirrors the docs sidebar order (Platform-first). The
// narrative of how the pieces fit lives on /how-it-works/ — linked, not repeated.
const startHere = [
  { href: '/docs/getting-started/', title: 'Quickstart', blurb: 'The self-hosted golden path: reference stack, Skills, connect Claude Code, onboard your project.' },
  { href: '/install-with-ai/', title: 'Install with your AI', blurb: 'Let Claude Code read llms.txt and run the Quickstart for you.' },
  { href: '/docs/self-hosting/', title: 'Advanced install', blurb: 'Step by step: engine only, your own Postgres, build from source, every setting.' },
];

const concepts = [
  { href: '/how-it-works/', title: 'How it works', blurb: 'How the Platform, the Skills and the CLI are wired together over MCP.' },
  { href: '/principles/', title: 'Principles', blurb: 'The design stances behind the project.' },
  { href: '/use-cases/', title: 'Use cases', blurb: 'What you get out of it, day to day.' },
];

const categories = [
  {
    label: 'KB Engine (the required core)',
    blurb: 'The self-hostable knowledge base your agent reads and writes — start here.',
    items: [
      { href: '/docs/platform/', title: 'Platform', blurb: 'A self-hostable KB on PostgreSQL that finds your project knowledge by meaning.' },
      { href: '/docs/entities/', title: 'Entities', blurb: 'The typed entity model: what each type is for and how they relate.' },
    ],
  },
  {
    label: 'Skills (your day-to-day)',
    blurb: 'The Claude Code plugin that runs pipelines as one-command workflows on the Platform.',
    items: [
      { href: '/docs/skills/', title: 'Skills', blurb: 'The Claude Code plugin: thin skills, with the knowledge living in the KB.' },
    ],
  },
  {
    label: 'Pipelines',
    blurb: 'How changes land together, or not at all.',
    items: [
      { href: '/docs/pipelines/', title: 'Pipelines', blurb: 'Transactions, draft/activate/cancel, and the typed server-side changelog.' },
    ],
  },
  {
    label: 'CLI & Security (optional to get started)',
    blurb: 'A foundational security layer you add when you want your agent to run real ops without seeing your tokens.',
    items: [
      { href: '/docs/cli/', title: 'CLI', blurb: 'The Rust binary: a zero-knowledge vault and an MCP capability broker.' },
      { href: '/docs/security/', title: 'Security', blurb: 'The zero-knowledge vault, signed allowlists and the threat model behind them.' },
    ],
  },
];
---

<DocsLayout
  title="Documentation — Kvendra developer docs"
  description="The Kvendra developer documentation index: install and self-host, the KB engine and its entity model, the Skills plugin, pipelines, and the optional CLI and its security model."
>
  <span class="kvd-kicker">Documentation</span>
  <h1>Documentation</h1>
  <p>
    Everything you need to run open-core Kvendra yourself and understand how it
    works. New here? Start with the <a href="/docs/getting-started/">Quickstart</a>.
    For the big picture first, read <a href="/how-it-works/">How it works</a>.
  </p>

  <section>
    <h2>Start here</h2>
    <ul>
      {startHere.map((item) => (
        <li>
          <a href={item.href}>{item.title}</a> — {item.blurb}
        </li>
      ))}
    </ul>
  </section>

  {
    categories.map((cat) => (
      <section>
        <h2>{cat.label}</h2>
        <p>{cat.blurb}</p>
        <ul>
          {cat.items.map((item) => (
            <li>
              <a href={item.href}>{item.title}</a> — {item.blurb}
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  <section>
    <h2>Concepts</h2>
    <ul>
      {concepts.map((item) => (
        <li>
          <a href={item.href}>{item.title}</a> — {item.blurb}
        </li>
      ))}
    </ul>
  </section>
</DocsLayout>
