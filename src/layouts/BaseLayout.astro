---
/**
 * BaseLayout — the single page shell for kvendra.dev.
 *
 * - Dual dark/light theme. Default dark; [data-theme="light"] flips the palette.
 * - Anti-FOUC: /scripts/theme-init.js (copied from the Kvendra brand kit, v0.6.x)
 *   runs synchronously in <head> before first paint, setting data-theme from
 *   localStorage.kvendra-theme before any pixel is drawn.
 * - Theme toggle in the header persists the choice to localStorage.
 * - Self-hosted fonts via Fontsource (no external font CDN): Space Grotesk
 *   (display/body), JetBrains Mono (code), Newsreader (serif).
 */
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/newsreader/400-italic.css';
import '../styles/tokens.css';
import '../styles/reset.css';
import '../styles/global.css';
import Lockup from '../components/brand/Lockup.astro';
import ThemeToggle from '../components/layout/ThemeToggle.astro';
import NavDropdown from '../components/layout/NavDropdown.astro';

interface Props {
  title?: string;
  description?: string;
  /** Absolute URL of a self-hosted Open Graph image (optional). */
  ogImage?: string;
  /** Open Graph type (default "website"; a lab page is an "article"). */
  ogType?: string;
}

const {
  title = 'Kvendra — developer docs',
  description = 'Open-core developer documentation for Kvendra: CLI, Platform and Skills. Architecture, security, embeddings, entities, pipelines and SQL.',
  ogImage,
  ogType = 'website',
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://kvendra.dev');

// Academy (ISSUE-KVD-DEV-75677F): header and footer link, shown as current on /academy/.
const academyCurrent = Astro.url.pathname.startsWith('/academy/') ? 'page' : undefined;

// Docs and Labs (ISSUE-KVD-DEV-6A0484): same mechanism, current on /docs/* and on /labs/*.
const docsCurrent = Astro.url.pathname.startsWith('/docs/') ? 'page' : undefined;
const labsCurrent = Astro.url.pathname.startsWith('/labs/') ? 'page' : undefined;

// Product menu — outcome-led entry points into the docs.
const productItems = [
  { href: '/docs/platform/', label: 'KB Engine' },
  { href: '/docs/skills/', label: 'Skills for AI agents' },
  { href: '/docs/cli/', label: 'CLI & Broker' },
  { href: '/how-it-works/', label: 'How it works' },
  { href: '/use-cases/', label: 'Use cases' },
  { href: '/principles/', label: 'Principles' },
];

// Community menu — the community hub plus the public GitHub org.
const communityItems = [
  { href: '/community/', label: 'Community hub' },
  { href: '/community/#ask', label: 'Ask or report an issue' },
  { href: '/community/#contribute', label: 'Contribute' },
  { href: 'https://github.com/KvendraAI', label: 'GitHub org' },
];

const githubUrl = 'https://github.com/KvendraAI/kvendra-cli';

// Follow links (footer) and Organization JSON-LD sameAs — same URLs, same order.
const followLinks = [
  { href: 'https://www.linkedin.com/company/kvendraai', label: 'LINKEDIN ↗' },
  { href: 'https://x.com/kvendraai', label: 'X ↗' },
  { href: 'https://github.com/KvendraAI', label: 'GITHUB ↗' },
  { href: 'https://www.youtube.com/@kvendraai', label: 'YOUTUBE ↗', icon: 'youtube' },
];

const organizationJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Kvendra',
  url: 'https://kvendra.dev/',
  logo: 'https://kvendra.dev/brand/kvendra-mark.svg',
  sameAs: followLinks.map((l) => l.href),
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/brand/kvendra-favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Kvendra" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <!-- Anti-FOUC: sync, pre-paint, same-origin (CSP-safe). -->
    <script is:inline src="/scripts/theme-init.js"></script>
    <!-- Nav dropdown close-behaviour: deferred, same-origin (CSP-safe). -->
    <script is:inline defer src="/scripts/nav.js"></script>
    <!-- Organization JSON-LD: a data block, not executed (CSP unchanged). -->
    <script is:inline type="application/ld+json" set:html={organizationJsonLd} />
    <!-- Page-specific head additions (e.g. a lab's TechArticle JSON-LD data block). -->
    <slot name="head" />
  </head>
  <body>
    <div class="kvd-shell">
      <header class="kvd-header">
        <div class="kvd-header__inner">
          <a href="/" aria-label="Kvendra home">
            <Lockup size={20} />
          </a>
          <nav class="kvd-nav" aria-label="Primary">
            <NavDropdown label="Product" items={productItems} />
            <a href="/docs/" aria-current={docsCurrent}>Docs</a>
            <a href="/labs/" aria-current={labsCurrent}>Labs</a>
            <a href="/academy/" aria-current={academyCurrent}>Academy</a>
            <NavDropdown label="Community" items={communityItems} />
            <a class="kvd-nav__disabled" aria-disabled="true">Blog</a>
            <a class="kvd-nav__github" href={githubUrl}>GitHub ★</a>
            <a class="kvd-nav__ai" href="/install-with-ai/">Install with your AI</a>
            <a class="kvd-nav__cta" href="/docs/getting-started/">Get Started</a>
            <ThemeToggle />
          </nav>
        </div>
      </header>

      <main class="kvd-main">
        <div class="kvd-container">
          <slot />
        </div>
      </main>

      <footer class="kvd-footer">
        <div class="kvd-footer__inner">
          <span>
            kvendra.dev — open-core developer docs. Generated from the Kvendra
            knowledge base.
          </span>
          <nav class="kvd-footer__nav" aria-label="Footer">
            <a href="/how-it-works/">How it works</a>
            <a href="/use-cases/">Use cases</a>
            <a href="/principles/">Principles</a>
            <a href="/docs/getting-started/">Get Started</a>
            <a href="/academy/" aria-current={academyCurrent}>Academy</a>
            <a href="/community/">Community</a>
          </nav>
          <nav class="kvd-footer__nav" aria-label="Follow">
            {
              followLinks.map((l) => (
                <a href={l.href} target="_blank" rel="me noopener noreferrer">
                  {l.icon === 'youtube' && (
                    <svg
                      class="kvd-footer__icon"
                      viewBox="0 0 24 24"
                      width="14"
                      height="14"
                      aria-hidden="true"
                      focusable="false"
                    >
                      <path
                        fill="currentColor"
                        d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.6 15.6V8.4l6.2 3.6-6.2 3.6z"
                      />
                    </svg>
                  )}
                  {l.label}
                </a>
              ))
            }
          </nav>
          <span>
            CLI: Apache-2.0 · Skills: MIT · Platform: AGPL-3.0-only
          </span>
          <span>
            Code: MIT · Content:
            <a href="https://creativecommons.org/licenses/by/4.0/" rel="license"
              >CC-BY-4.0</a
            >
            ·
            <!-- commercial-pointer:start site-footer -->
            <a href="https://kvendra.com/">See the product →</a>
            <!-- commercial-pointer:end -->
          </span>
        </div>
      </footer>
    </div>

    <style>
      /* New-nav item styles. Scoped to BaseLayout; the global .kvd-nav a base
         (color/size/transition) still applies — these layer intent on top. */
      .kvd-nav__github {
        white-space: nowrap;
      }

      .kvd-nav__disabled {
        opacity: 0.5;
        cursor: default;
        pointer-events: none;
      }

      .kvd-nav__ai {
        white-space: nowrap;
      }

      .kvd-footer__nav {
        display: flex;
        flex-wrap: wrap;
        gap: var(--sp-4);
      }

      .kvd-footer__nav a[aria-current='page'] {
        color: var(--fg);
      }

      .kvd-footer__icon {
        display: inline-block;
        vertical-align: -2px;
        margin-right: var(--sp-1);
      }

      .kvd-nav__cta {
        padding: var(--sp-2) var(--sp-4);
        border: 1px solid var(--phos);
        color: var(--fg);
        white-space: nowrap;
        transition: background-color var(--dur-mecanico) var(--ease-mecanico),
          color var(--dur-mecanico) var(--ease-mecanico);
      }
      .kvd-nav__cta:hover {
        background: var(--phos);
        color: var(--ink);
      }
    </style>
  </body>
</html>
