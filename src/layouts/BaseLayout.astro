---
/**
 * BaseLayout — the single page shell for kvendra.dev.
 *
 * - Dual dark/light theme. Default dark; [data-theme="light"] flips the palette.
 * - Anti-FOUC: /scripts/theme-init.js (copied from kvendra-web, REL-KVD-WEB-0.6.x)
 *   runs synchronously in <head> before first paint, setting data-theme from
 *   localStorage.kvendra-theme before any pixel is drawn.
 * - Theme toggle in the header persists the choice to localStorage.
 * - Self-hosted fonts via Fontsource (no external font CDN): Space Grotesk
 *   (display/body), JetBrains Mono (code), Newsreader (serif).
 */
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/newsreader/400-italic.css';
import '../styles/tokens.css';
import '../styles/reset.css';
import '../styles/global.css';
import Lockup from '../components/brand/Lockup.astro';
import ThemeToggle from '../components/layout/ThemeToggle.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Kvendra — developer docs',
  description = 'Open-core developer documentation for Kvendra: CLI, Platform and Skills. Architecture, security, embeddings, entities, pipelines and SQL.',
} = Astro.props;

const nav = [
  { href: '/', label: 'Home' },
  { href: '/cli/', label: 'CLI' },
  { href: '/security/', label: 'Security' },
  { href: '/platform/', label: 'Platform' },
  { href: '/skills/', label: 'Skills' },
  { href: '/entities/', label: 'Entities' },
  { href: '/pipelines/', label: 'Pipelines' },
  { href: '/sql/', label: 'SQL' },
];

const here = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/brand/kvendra-favicon.svg" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site ?? 'https://kvendra.dev')} />
    <!-- Anti-FOUC: sync, pre-paint, same-origin (CSP-safe). -->
    <script is:inline src="/scripts/theme-init.js"></script>
  </head>
  <body>
    <div class="kvd-shell">
      <header class="kvd-header">
        <div class="kvd-header__inner">
          <a href="/" aria-label="Kvendra home">
            <Lockup size={20} />
          </a>
          <nav class="kvd-nav" aria-label="Primary">
            {
              nav.map((item) => (
                <a
                  href={item.href}
                  aria-current={here === item.href ? 'page' : undefined}
                >
                  {item.label}
                </a>
              ))
            }
            <ThemeToggle />
          </nav>
        </div>
      </header>

      <main class="kvd-main">
        <div class="kvd-container">
          <slot />
        </div>
      </main>

      <footer class="kvd-footer">
        <div class="kvd-footer__inner">
          <span>
            kvendra.dev — open-core developer docs. Generated from the Kvendra
            knowledge base.
          </span>
          <span>
            Code: MIT · Content:
            <a href="https://creativecommons.org/licenses/by/4.0/" rel="license"
              >CC-BY-4.0</a
            >
            ·
            <a href="https://kvendra.com">See the product →</a>
          </span>
        </div>
      </footer>
    </div>
  </body>
</html>
