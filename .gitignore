# Build output
dist/

# Dependencies
node_modules/

# Astro generated types
.astro/

# KB cache directory — transient fetch artifacts are not committed...
# (ignore the directory's CONTENTS, not the directory: git cannot re-include a
# file whose parent directory is excluded)
src/content/.kb-cache/*
# ...except the reproducible, hand-vetted offline dump, which IS committed so
# the build is deterministic without a live MCP connection (see scripts/kb-fetch.mjs).
# The content linter scans it on every build.
!src/content/.kb-cache/kb-dump.json

# OS / editor
.DS_Store
*.log

# Agent boot-ROM — internal, never publish
CLAUDE.md
